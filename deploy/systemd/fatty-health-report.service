[Unit]
Description=Fatty deterministic Telegram health report
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/home/valarion/apps/fatty-multi-exchange-trader
ExecStart=/usr/bin/flock -n /tmp/fatty-health-report.lock /bin/bash /home/valarion/apps/fatty-multi-exchange-trader/scripts/telegram_health_report.sh
TimeoutStartSec=30
