# PAPER-only defaults. Keep actual secrets in the deployment environment, never here.
APP_ENV=development
GLOBAL_MODE=PAPER
TG_OPERATOR_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TG_BOT_TOKEN=
TELEGRAM_TARGET_CHAT_ID=
# Legacy operator command bot values; no notification delivery occurs without TG_BOT_TOKEN.
TELEGRAM_BOT_TOKEN=
POSTGRES_DSN=postgresql://fatty_app:change-me@postgres:5432/fatty_trader
# Production Compose: POSTGRES_PASSWORD is admin/migration/backup-only.
# Provision WORKER_DB_PASSWORD privately with scripts/provision_worker_database.py.
# Runtime services use fatty_worker; the console web role remains separate.
WORKER_DB_PASSWORD=
WEB_HOST_PORT=18081
BINANCE_API_KEY=
BINANCE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
